{
  "manifest_version": 3,
  "name": "Suno AI Metadata & Lyrics Downloader",
  "version": "2.0.0",
  "description": "Suno AI sarkilarinin tam stil promptunu ve sozlerini tek tikla .txt olarak indirir.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://studio-api.prod.suno.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
